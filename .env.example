# ---------------------------------------------------------------------------
# Sentinel-FX environment.
#
# Copy to `.env` (compose) or /etc/sentinel/sentinel.env (systemd), then:
#     chmod 600 .env
#
# Nothing in this file belongs in the repository, in the config JSON, or in a
# screenshot. The process reads credentials from the environment only and
# refuses to start in live mode without them.
# ---------------------------------------------------------------------------

# --- Dashboard sessions ----------------------------------------------------
# Signs the session tokens. If unset, a random one is generated at startup and
# every session dies on restart. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTINEL_JWT_SECRET=

# --- First owner account ---------------------------------------------------
# Used ONLY to create the owner when no such account exists yet. Accounts are
# then stored in <state_dir>/users.db (0600) and survive restarts, so these
# lines are ignored on every subsequent boot -- an existing account is never
# overwritten from the environment. Delete them once the account exists.
#
# You can skip them entirely and create the owner on the server instead:
#     python scripts/manage_users.py add --username owner --role owner
SENTINEL_ADMIN_USER=owner
SENTINEL_ADMIN_PASSWORD=
# Leave blank. The process prints an otpauth:// URI once, at creation. Set this
# only for reproducible provisioning, and understand that it puts the second
# factor in a file next to the password.
SENTINEL_ADMIN_TOTP_SECRET=

# --- Binding ---------------------------------------------------------------
# The API refuses to bind beyond loopback unless this is 1. Set it ONLY when
# something else provides the isolation -- a container port mapped to
# 127.0.0.1, or an authenticating reverse proxy. A dashboard with trading
# authority on an open port is equivalent to publishing the account.
SENTINEL_ALLOW_PUBLIC_BIND=0

# --- Configuration location ------------------------------------------------
# Leave this COMMENTED OUT for a systemd install: the unit sets an absolute
# path, and an EnvironmentFile entry would override it with a relative one.
# Set it only when you run the server by hand from a checkout.
#SENTINEL_CONFIG=var/config.json

# --- Reverse proxy ---------------------------------------------------------
# Only set this when a reverse proxy really is in front of the app, and list
# its address. Unset means X-Forwarded-For is ignored entirely, which is the
# correct and safe setting for a loopback bind or an SSH tunnel.
#SENTINEL_TRUSTED_PROXY=127.0.0.1

# --- Broker: OANDA (v20 REST) ----------------------------------------------
# Required when execution.broker = "oanda" AND execution.venue_mode = "live".
# Practice credentials are a different account id and a different host.
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
OANDA_API_HOST=https://api-fxpractice.oanda.com
# Live host: https://api-fxtrade.oanda.com

# --- Broker: CCXT (crypto venues) ------------------------------------------
CCXT_EXCHANGE=
CCXT_API_KEY=
CCXT_SECRET=

# --- Broker: MetaTrader 5 ---------------------------------------------------
# The MetaTrader5 package is Windows-only. On a Linux host the terminal runs on
# a Windows machine with scripts/mt5_bridge.py and an SSH tunnel to this host;
# these two make the engine use it. deploy/scripts/connect-mt5.sh sets them.
SENTINEL_MT5_BRIDGE=
SENTINEL_MT5_BRIDGE_TOKEN=
# Sign-in credentials are saved through the dashboard (sealed store), not here.

# --- News extraction (optional) --------------------------------------------
# Only read when news.llm_enabled = true. The lookahead-propensity test must
# pass before a language model is allowed to influence anything but a filter.
ANTHROPIC_API_KEY=
