# Line endings are part of correctness here, not style.
#
# 1.3.0 and 1.4.0 shipped deploy/scripts/install.sh with CRLF line endings,
# which makes the shebang read "bash\r" and the documented one-command install
# fail on every Linux host before it runs a single line. Pin every text format
# to the line ending its interpreter requires, so a checkout on Windows cannot
# reintroduce that failure.
*           text=auto eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
# PowerShell and batch files are executed by Windows tooling, which expects CRLF.
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf
# Binary assets.
*.woff2     binary
*.pdf       binary
*.png       binary
*.ico       binary
